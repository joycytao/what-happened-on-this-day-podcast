{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResearchReferences",
  "type": "object",
  "properties": {
    "episodeDate": { "type": "string" },
    "chosenSubject": { "type": "string" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "summary": { "type": "string", "minLength": 1 },
          "source": {
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "url": { "type": "string", "format": "uri" },
              "sourceType": { "enum": ["wikipedia", "official", "reference", "archive", "news"] }
            },
            "required": ["title", "url", "sourceType"],
            "additionalProperties": false
          }
        },
        "required": ["id", "summary", "source"],
        "additionalProperties": false
      }
    }
  },
  "required": ["episodeDate", "chosenSubject", "items"],
  "additionalProperties": false
}
