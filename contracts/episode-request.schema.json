{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EpisodeRequest",
  "type": "object",
  "properties": {
    "date": { "type": "string" },
    "episodeSlug": { "type": "string" },
    "language": { "const": "en" },
    "audience": { "const": "children-first-adult-friendly" },
    "durationTargetMin": { "type": "number", "minimum": 5, "maximum": 8 },
    "durationMaxMin": { "const": 8 },
    "selectedAngle": { "type": "string" },
    "entityType": { "enum": ["person", "event", "object"] },
    "currentStage": { "enum": ["ready", "researching", "writing", "producing", "review", "done", "blocked"] }
  },
  "required": ["date", "episodeSlug", "language", "audience", "durationTargetMin", "durationMaxMin", "currentStage"],
  "additionalProperties": false
}
